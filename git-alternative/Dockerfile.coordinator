FROM rust:1.88-bookworm@sha256:af306cfa71d987911a781c37b59d7d67d934f49684058f96cf72079c3626bfe0 AS builder
RUN rustup toolchain install 1.89.0 && rustup default 1.89.0
WORKDIR /usr/src/spine
COPY git-alternative ./git-alternative
RUN cargo build --release --manifest-path git-alternative/Cargo.toml -p spine-coordinator

FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd -g 10001 spine && useradd -u 10001 -g spine -s /bin/false -m spine
RUN mkdir -p /var/lib/spine && chown -R spine:spine /var/lib/spine
COPY --from=builder /usr/src/spine/git-alternative/target/release/spine-coordinator /usr/local/bin/spine-coordinator
USER spine:spine
EXPOSE 8400
ENTRYPOINT ["/usr/local/bin/spine-coordinator"]
