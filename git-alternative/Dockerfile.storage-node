FROM rust:1.80-bullseye AS builder
WORKDIR /usr/src/spine
COPY git-alternative ./git-alternative
RUN cargo build --release --manifest-path git-alternative/Cargo.toml -p spine-storage-node

FROM debian:bullseye-slim
RUN groupadd -g 10001 spine && useradd -u 10001 -g spine -s /bin/false -m spine
RUN mkdir -p /var/lib/spine && chown -R spine:spine /var/lib/spine
COPY --from=builder /usr/src/spine/git-alternative/target/release/spine-storage-node /usr/local/bin/spine-storage-node
USER spine:spine
EXPOSE 9101
ENTRYPOINT ["/usr/local/bin/spine-storage-node"]
