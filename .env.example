# ==============================================================================
# Spine Forge - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting services:
#   cp .env.example .env
#
# DO NOT commit .env files containing production secrets to version control.
# Generate cryptographic secrets using: openssl rand -hex 32
# ==============================================================================

# --- Deployment Profile ---
# Core Forge v1 mandates PostgreSQL persistence, TLS ingress, and disables untrusted CI.
SPINE_DEPLOYMENT_PROFILE=core-forge-v1

# --- Networking & Ingress Origin ---
# Public-facing origin used for webhook callbacks, Git clone URLs, and redirect links.
# MUST be an https:// URL in production.
FORGE_PUBLIC_ORIGIN=https://forge.example.com
APP_URL=https://forge.example.com
BIND=0.0.0.0
PORT=3000
SSH_PORT=2222
SSH_ADDR=0.0.0.0:2222

# --- TLS Ingress Termination Gateway Certificates ---
# Absolute or relative filesystem paths on the Docker host to TLS certificate and key.
# Mounted read-only into the edge ingress proxy (/etc/spine/certs/tls.crt and tls.key).
SPINE_TLS_CERT_FILE=./deploy/nginx/certs/tls.crt
SPINE_TLS_KEY_FILE=./deploy/nginx/certs/tls.key

# --- Cryptographic Authentication & Token Secrets ---
# Mandatory secret key (min 32 characters) used for signing RemoteAuth tokens,
# session cookies, and Git HTTP/SSH access tokens.
# Generation command: openssl rand -hex 32
SPINE_AUTH_SECRET_KEY=replace_with_32_character_cryptographically_secure_auth_secret

# Optional dedicated LFS secret (min 32 characters). If unset, SPINE_AUTH_SECRET_KEY is used.
SPINE_LFS_SECRET=replace_with_32_character_cryptographically_secure_lfs_secret

# Optional path to backup encryption passphrase file (AES-256-GCM / PBKDF2)
SPINE_BACKUP_PASSPHRASE_FILE=/etc/spine/backup_key.secret

# --- PostgreSQL Database Role Separation (Least Privilege) ---
# Core Forge enforces three segregated database roles:
# 1. Admin: superuser/cluster bootstrap (container init only)
POSTGRES_DB=spine_forge
POSTGRES_ADMIN_USER=spine_admin
POSTGRES_ADMIN_PASSWORD=replace_with_strong_admin_password_min_32_chars

# 2. Migrator: DDL owner of schema 'public' (runs schema migrations at startup)
POSTGRES_MIGRATOR_USER=spine_migrator
POSTGRES_MIGRATOR_PASSWORD=replace_with_strong_migrator_password_min_32_chars

# 3. Application: DML only (SELECT, INSERT, UPDATE, DELETE). Table creation revoked.
POSTGRES_APP_USER=spine_app
POSTGRES_APP_PASSWORD=replace_with_strong_app_password_min_32_chars

# Composite database connection string (used by spine-api in direct host/standalone mode)
DATABASE_URL=postgres://spine_app:replace_with_strong_app_password_min_32_chars@postgres:5432/spine_forge
SPINE_DATABASE_URL=postgres://spine_app:replace_with_strong_app_password_min_32_chars@postgres:5432/spine_forge

# Database connection pool sizing
DATABASE_MAX_CONNECTIONS=50
DATABASE_MIN_CONNECTIONS=10
DATABASE_TIMEOUT_SECONDS=30
SPINE_DB_MAX_CONNECTIONS=50
SPINE_DB_MIN_CONNECTIONS=10
SPINE_DB_TIMEOUT_SECONDS=30

# --- Storage & Cluster Consensus Topology ---
# Local mount point or volume for native repositories and artifacts
STORAGE_ROOT=/var/lib/spine/storage
SPINE_STORAGE_ROOT=/var/lib/spine/storage

# Consensus coordinator Raft address
COORDINATOR_ADDR=coordinator:8400
SPINE_COORDINATOR_ADDR=coordinator:8400

# Storage node topology
STORAGE_NODES=node-1=storage-node-1:8401,node-2=storage-node-2:8401,node-3=storage-node-3:8401
SPINE_STORAGE_NODES=node-1=storage-node-1:8401,node-2=storage-node-2:8401,node-3=storage-node-3:8401

# --- Security Controls & Sandboxing ---
# Untrusted workflow runners MUST remain disabled (false) on Core Forge control plane hosts.
UNTRUSTED_WORKFLOW_RUNNER_ENABLED=false
SPINE_CI_LOCAL_RUNNER_ENABLED=false
SPINE_ALLOW_REGISTRATION=false

# --- Logging & Telemetry ---
RUST_LOG=info,spine_api=info,tower_http=info
