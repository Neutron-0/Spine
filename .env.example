# Spine Forge Environment Configuration Example

# Backend Server Configuration
PORT=3000
BIND=127.0.0.1
RUST_LOG=info,spine_api=debug

# Storage & Distributed Backend
# Root directory where native .spine repository files and loose objects reside
STORAGE_ROOT=./data/storage

# Spine Coordinator RPC Address (optional, falls back to direct local provisioning if not set)
COORDINATOR_ADDR=127.0.0.1:8400

# Database Configuration
# Set to 'true' to run fully hermetic in-memory mode (ideal for development and tests without PostgreSQL)
IN_MEMORY_DB=false

# PostgreSQL Connection String (required if IN_MEMORY_DB=false)
DATABASE_URL=postgres://spine_app:spine_dev_password@127.0.0.1:5432/spine_forge

# Session & Security Configuration
# Cookie secret / signing salt
SESSION_TTL_DAYS=30

# Rate Limiting
MAX_LOGIN_ATTEMPTS_PER_MINUTE=10

# Mail Delivery (Development in-memory catcher or SMTP)
MAIL_PROVIDER=in_memory
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@spine.build
# SMTP_PASS=secret
