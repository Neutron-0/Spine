# ==============================================================================
# Spine Forge Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting services:
#   cp .env.example .env
#
# DO NOT commit the .env file containing production secrets to version control.
# ==============================================================================

# --- Networking & Bind Settings ---
BIND=0.0.0.0
PORT=3000
SSH_PORT=2222
SSH_ADDR=0.0.0.0:2222

# Public-facing URL used for webhook callbacks, clone URLs, and redirect links
FORGE_PUBLIC_ORIGIN=https://forge.example.com
APP_URL=https://forge.example.com

# --- Database Configuration ---
# Required for production multi-node operation.
# Leave unset or pass --in-memory-db only for zero-dependency local testing.
DATABASE_URL=postgres://spine_app:change_this_to_a_secure_password@postgres:5432/spine_forge
POSTGRES_DB=spine_forge
POSTGRES_USER=spine_app
POSTGRES_PASSWORD=change_this_to_a_secure_password

# --- Storage & Cluster Configuration ---
# Local mount point or volume for native repositories and artifacts
STORAGE_ROOT=/var/lib/spine/storage

# Spine Coordinator gRPC/RPC address
COORDINATOR_ADDR=coordinator:8400

# --- Runner & Security Isolation Profile ---
# In Core Forge deployments without microVM sandboxes (Firecracker/gVisor),
# untrusted runner execution MUST remain disabled (false) to prevent host compromise.
UNTRUSTED_WORKFLOW_RUNNER_ENABLED=false

# --- Logging & Telemetry ---
RUST_LOG=info,spine_api=info,tower_http=info
