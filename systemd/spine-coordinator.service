[Unit]
Description=Spine Distributed Cluster Coordinator
Documentation=https://github.com/spine-vcs/spine
After=network.target

[Service]
Type=simple
User=spine
Group=spine
WorkingDirectory=/var/lib/spine
EnvironmentFile=-/etc/spine/spine-coordinator.env
ExecStart=/usr/local/bin/spine-coordinator \
    --bind 0.0.0.0:8400 \
    --state-file /var/lib/spine/coordinator.state

Restart=always
RestartSec=3s
LimitNOFILE=65536

# Security Hardening Directives
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/spine

[Install]
WantedBy=multi-user.target
