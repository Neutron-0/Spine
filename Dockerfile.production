# Production Container Image for Spine Forge Control Plane & Storage Node
# Multi-stage build with zero build tools in final unprivileged runtime

FROM rust:1.88-bookworm AS builder

WORKDIR /usr/src/spine

COPY git-alternative ./git-alternative
COPY github-alternative/backend ./github-alternative/backend

RUN cargo build --release --manifest-path github-alternative/backend/Cargo.toml -p spine-api

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 10001 spine && \
    useradd -u 10001 -g spine -s /bin/false -m spine

RUN mkdir -p /var/lib/spine/storage /var/lib/spine/ssh /var/lib/spine/backups && \
    chown -R spine:spine /var/lib/spine

WORKDIR /var/lib/spine

COPY --from=builder /usr/src/spine/github-alternative/backend/target/release/spine-api /usr/local/bin/spine-api

USER spine:spine

EXPOSE 3000
EXPOSE 2222

ENV BIND="0.0.0.0"
ENV PORT="3000"
ENV SSH_PORT="2222"
ENV STORAGE_ROOT="/var/lib/spine/storage"

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=5 \
    CMD curl -f http://127.0.0.1:3000/health/ready || exit 1

ENTRYPOINT ["/usr/local/bin/spine-api"]
CMD ["serve", "--bind", "0.0.0.0", "--port", "3000", "--ssh-port", "2222", "--storage-root", "/var/lib/spine/storage"]
