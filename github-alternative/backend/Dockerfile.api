# Multi-stage build for Spine Forge API & SSH Service
FROM rust:1.88-bookworm@sha256:af306cfa71d987911a781c37b59d7d67d934f49684058f96cf72079c3626bfe0 AS builder
RUN rustup toolchain install 1.89.0 && rustup default 1.89.0

WORKDIR /usr/src/spine

# Copy workspaces
COPY git-alternative ./git-alternative
COPY github-alternative/backend ./github-alternative/backend

# Build release binary for spine-api
RUN cargo build --release --manifest-path github-alternative/backend/Cargo.toml -p spine-api

# Minimal unprivileged runtime image
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged service user and group (UID 10001, GID 10001)
RUN groupadd -g 10001 spine && \
    useradd -u 10001 -g spine -s /bin/false -m spine

# Setup persistent application directories
RUN mkdir -p /var/lib/spine/storage /var/lib/spine/ssh && \
    chown -R spine:spine /var/lib/spine

WORKDIR /var/lib/spine

COPY --from=builder /usr/src/spine/github-alternative/backend/target/release/spine-api /usr/local/bin/spine-api

USER spine:spine

EXPOSE 3000
EXPOSE 2222

ENV BIND="0.0.0.0"
ENV PORT="3000"
ENV SSH_PORT="2222"
ENV STORAGE_ROOT="/var/lib/spine/storage"

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=5 \
    CMD curl -f http://127.0.0.1:3000/health/ready || exit 1

ENTRYPOINT ["/usr/local/bin/spine-api"]
CMD ["serve"]
